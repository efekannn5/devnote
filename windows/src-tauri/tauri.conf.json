{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevNote",
  "mainBinaryName": "DevNote",
  "version": "0.1.0",
  "identifier": "com.efekan.devnote.windows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DevNote",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https://*.icloud-content.com https://*.apple-cloudkit.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.apple-cloudkit.com https://*.apple-cloudkit.com https://*.icloud-content.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Efekan",
    "copyright": "© 2026 Efekan",
    "category": "Productivity",
    "shortDescription": "DevNote — notlar ve görevler",
    "longDescription": "DevNote: iCloud ile Mac ve iPhone'daki notlarınla anında eşitlenen not ve görev uygulaması.",
    "homepage": "https://github.com/efekan/devnote",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "DevNote"
      },
      "signCommand": {
        "cmd": "bash",
        "args": [
          "../scripts/sign.sh",
          "%1"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cloudkit-icloud.com.efekan.devnote"
        ]
      }
    }
  }
}